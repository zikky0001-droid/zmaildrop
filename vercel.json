{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/maildrop.js": { "maxDuration": 10 },
    "api/v1/health.js": { "maxDuration": 10 },
    "api/v1/domains.js": { "maxDuration": 10 },
    "api/v1/inbox.js": { "maxDuration": 10 },
    "api/v1/message.js": { "maxDuration": 10 },
    "api/v1/cleanup.js": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/v1/cleanup", "schedule": "0 23 * * *" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/login", "dest": "/login.html" },
    { "src": "/inbox", "dest": "/inbox.html" },
    { "src": "/view",  "dest": "/view.html" },
    { "src": "/(.*)",  "dest": "/404.html", "status": 404 }
  ]
}

