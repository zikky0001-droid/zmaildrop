{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/maildrop.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/login", "dest": "/login.html" },
    { "src": "/inbox", "dest": "/inbox.html" },
    { "src": "/view",  "dest": "/view.html" },
    { "src": "/(.*)",  "dest": "/404.html", "status": 404 }
  ]
}

