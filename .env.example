# ZMAIL Drop API — Environment Variables
# Copy this file to `.env` and fill in real values.
#
# Used by:
#   api/v1/utils.js       (Firebase Admin + rate limiting)
#   api/v1/cleanup.js     (CRON_SECRET auth)

# Firebase project ID (e.g. zikky-xxxxxx12)
PROJECT_KEY=

# Firebase service account email
# From Firebase Console → Project Settings → Service Accounts → Generate new private key
EMAIL_KEY=

# Firebase service account private key
# Keep the \n characters as literal text (do NOT press Enter)
PRIVATE_KEY=

# Secret used to authenticate the daily cleanup cron job
# Must match what Vercel sends on /api/v1/cleanup
# Generate with: echo "zmaildrop$(openssl rand -hex 12 | cut -c1-23)"
CRON_SECRET=
